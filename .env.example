# ===========================================
# ENVIRONMENT VARIABLES EXAMPLE
# Bedoui Fullstack Application
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ---- BACKEND (.env) ----

# Server Configuration
NODE_ENV=development
PORT=5000

# SMTP Configuration (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# API Security
API_KEY=your-secure-api-key-here
ENCRYPTION_KEY=your-32-character-encryption-key

# Download Token Security
DOWNLOAD_TOKEN_SECRET=your-download-secret-key
DOWNLOAD_TOKEN_TTL_SECONDS=3600

# Duplicate Request Protection
DUPLICATE_WINDOW_SECONDS=15

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq AI (Optional - for AI features)
GROQ_API_KEY=your-groq-api-key

# Company Info
COMPANY_NAME=Bedouielec Transformateurs
RECEIVER_EMAIL=admin@bedouielec.com

# PDF Configuration
PDF_STORAGE_PATH=generated-pdfs
PDF_TEMPLATE_PATH=templates/devis-pdf.ejs

# ---- FRONTEND (.env) ----

# API Configuration
VITE_API_KEY=your-api-key
VITE_BACKEND_URL=http://localhost:5000

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# ---- SECURITY NOTES ----
# - Use strong, unique keys for ENCRYPTION_KEY and DOWNLOAD_TOKEN_SECRET
# - Rotate API keys regularly
# - Never share .env files
# - Use environment-specific .env files (.env.development, .env.production)
